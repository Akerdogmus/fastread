# Normalize line endings so the repo stays consistent across Windows/macOS/Linux.
* text=auto eol=lf

# The double-clickable Windows launchers must keep CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf

# Binary assets — never diffed or line-ending-converted.
*.png binary
*.ico binary
*.icns binary
*.pdf binary
*.woff binary
*.woff2 binary
